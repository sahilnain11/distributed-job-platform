# Local-development values only. These are NOT production credentials.
DB_USERNAME=job_platform
DB_PASSWORD=local-development-only
DB_PORT=5432
# Spring Boot does not load .env files automatically. Export variables in the
# application shell as well if you change these Compose values.
DB_URL=jdbc:postgresql://localhost:5432/job_platform
SERVER_PORT=8080
RABBITMQ_USERNAME=job_platform
RABBITMQ_PASSWORD=local-rabbit-development-only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Explicitly enable publishing, both demo handlers and reliability polling in
# the application shell. Plain application startup defaults to messaging off.
MESSAGING_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USERNAME=job_platform
GRAFANA_PASSWORD=local-grafana-development-only